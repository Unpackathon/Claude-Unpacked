{
  "name": "@ant/claude-native",
  "version": "0.0.0",
  "main": "index.js",
  "types": "index.d.ts",
  "private": true,
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "napi": {
    "name": "claude-native",
    "triples": {
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-pc-windows-msvc",
        "universal-apple-darwin"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@malept/cross-spawn-promise": "catalog:",
    "@napi-rs/cli": "catalog:",
    "@types/node": "catalog:",
    "listr2": "catalog:"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "build": "node ./scripts/build.mts",
    "build:debug": "node ./scripts/build.mts --debug",
    "lint": "cargo fmt --check && cargo clippy --locked -- -D warnings",
    "lint:fix": "cargo fmt && cargo clippy --fix -- -D warnings",
    "test:rs": "bun run lint && cargo test --locked && bun run test:rs:serial",
    "test:rs:serial": "cargo test --locked -- --ignored --test-threads=1 --exact platform::win32::app_scoped::actuator::tests::uia_bootstraps_on_an_mta_thread_with_autosetfocus_off platform::win32::app_scoped::capture::gdi::tests::print_window_renders_our_own_popup_and_honours_display_affinity platform::win32::app_scoped::capture::wgc::tests::a_d3d_device_can_be_created platform::win32::app_scoped::probe::tests::winrt_probes_do_not_throw",
    "napi": "napi"
  }
}
